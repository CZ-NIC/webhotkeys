# The existing git tags are bare versions (0.9.6), and the jsDelivr URLs in README.md resolve
# `WebHotkeys@0.10.0` to exactly such a tag. Keep `npm version` from prefixing them with a "v".
tag-version-prefix=""
# The release commit of `npm version` follows Conventional Commits like the rest of the history (%s = the version).
message="chore(release): %s"
