{
  "name": "webhotkeys",
  "version": "0.10.0",
  "description": "Easy solution to integrate keyboard hotkeys into the webpage.",
  "main": "src/WebHotkeys.js",
  "files": [
    "src/",
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CZ-NIC/webhotkeys.git"
  },
  "keywords": [
    "hotkeys",
    "keyboard",
    "shortcuts",
    "accesskey",
    "keybindings",
    "key-sequence",
    "vanilla-js"
  ],
  "author": "Edvard Rejthar",
  "license": "LGPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/CZ-NIC/webhotkeys/issues"
  },
  "homepage": "https://github.com/CZ-NIC/webhotkeys#readme",
  "module": "src/WebHotkeys.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/WebHotkeys.mjs",
      "require": "./src/WebHotkeys.js",
      "default": "./src/WebHotkeys.js"
    },
    "./WebHotkeys.js": "./src/WebHotkeys.js",
    "./WebHotkeys.min.js": "./dist/WebHotkeys.min.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "for f in test/*.test.js; do node \"$f\" || exit 1; done; node test/esm-import.test.mjs",
    "test:min": "WH_FILE=dist/WebHotkeys.min.js npm test",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "preversion": "npm run lint && npm test",
    "version": "npm run build && node scripts/stamp-changelog.js && npm run test:min && git add README.md CHANGELOG.md",
    "postversion": "git push --follow-tags",
    "release": "node scripts/release.js",
    "prepack": "npm run build && npm run test:min"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "globals": "^17.11.0"
  }
}
